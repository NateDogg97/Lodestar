# Cached HTTP responses and downloads. Regenerable — except the manual
# downloads (SEDA), which live in a private R2 bucket instead of git:
# `python -m etl.inputs pull` fetches them (etl/inputs.py).
data/raw/*
!data/raw/.gitkeep
!data/raw/cbsa_crosswalk_manual.csv

# Per-source tidy files. Regenerated by a fetch.
data/interim/*
!data/interim/.gitkeep

# Final artifacts. Commit these if you want the app to build without an ETL
# run; ignore them if you would rather they always be rebuilt.
data/out/*
!data/out/.gitkeep

.env
__pycache__/
*.pyc
