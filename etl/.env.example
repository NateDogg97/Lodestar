# Copy to .env and fill in. All keys are free and issued instantly.
#
# Census API key — https://api.census.gov/data/key_signup.html
# Used by: sources/acs.py
CENSUS_API_KEY=

# BEA API key — https://apps.bea.gov/API/signup/
# Used by: sources/bea.py
BEA_API_KEY=

# BLS API key — https://data.bls.gov/registrationEngine/
# Used by: sources/bls.py (county unemployment). Required: without it BLS
# allows 25 requests/day, and the 3,144 counties need 63.
BLS_API_KEY=

# EIA API key — https://www.eia.gov/opendata/register.php
# Used by: laws/sources/eia.py (electricity prices). Optional: without it the
# public DEMO_KEY is used. The monthly workflow reads it from the EIA_API_KEY
# repository secret instead of this file.
EIA_API_KEY=

# api.data.gov key — https://api.data.gov/signup/
# Not currently used: tracts/crime.py switched from the FBI Crime Data
# Explorer API to its bulk per-state files (Phase 8c), which need no key.
# Kept for ad-hoc CDE API queries (DEMO_KEY: 30 requests/hour; a key: 1,000).
DATA_GOV_API_KEY=

# NOAA and SEDA need no key.
#   NOAA is a plain file download.
#   SEDA is a MANUAL download — see sources/seda.py for the steps.

# Cloudflare R2 — where the app's tract files live in production (Phase 8c).
# Used by: tracts/upload.py, inputs.py (etl/r2.py). The same five go in the
# repo's Actions secrets for .github/workflows/tracts-refresh.yml.
# Cloudflare dashboard → R2 → Manage API tokens → create a token with "Object
# Read & Write" on both buckets; it shows the access key ID and secret once.
# The account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private bucket (no public access) for source files that can only be
# downloaded by hand (SEDA). Used by: inputs.py. Give the same token access.
R2_INPUTS_BUCKET=
