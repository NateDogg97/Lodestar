{
  "name": "new-home-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -p none \"serwist build serwist.config.mjs --watch\" \"next dev\"",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "d3-scale-chromatic": "^3.1.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
