# Cloudflare static-assets headers (copied into out/ by the build). Everything not
# listed keeps Cloudflare's default (public, max-age=0, must-revalidate).

# Never cache the service worker so users always pick up new versions.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Hashed build output never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTTPS only (the same value Vercel sent).
/*
  Strict-Transport-Security: max-age=63072000
