# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!/etl/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist (generated service worker)
/public/sw*
/public/swe-worker*

# python ETL (local tool — never part of the app build)
/etl/.venv/
__pycache__/
*.pyc
# NOTE: public/data/counties.json is deliberately NOT ignored. It is the
# ETL's published output and is what lets the app build without Python.

# MapLibre worker, copied from node_modules by scripts/copy-maplibre-worker.mjs
/public/maplibre/

# Phase 8 tract data (published by `python -m etl.tracts.publish`; hosted on R2 later)
/public/data/tracts/

# Results audit output (npm run audit:results)
/scripts/audit/report.md
